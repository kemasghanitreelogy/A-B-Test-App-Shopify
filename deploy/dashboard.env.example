# /etc/treelogy-ab-dash/env — root:treelogy-ab-dash, mode 640.
# NODE_ENV, HOSTNAME dan PORT diset oleh unit systemd, bukan di sini.
# Dibaca juga saat build (NEXT_SERVER_ACTIONS_ENCRYPTION_KEY, NEXT_PUBLIC_*).

# Supabase project `treelogy-ab`, role + schema `treelogy_ab`, lewat transaction
# pooler (port 6543). Dashboard tidak pernah migrate, jadi DIRECT_URL tidak perlu.
# postgresql://treelogy_ab.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&schema=treelogy_ab&pgbouncer=true&connection_limit=5
DATABASE_URL=

# Penandatangan cookie sesi, minimal 32 karakter: openssl rand -base64 48
SESSION_SECRET=

# Kunci AES Server Action yang sama untuk semua rilis, supaya tab yang dibuka
# sebelum deploy tetap bisa memanggil action: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Bridge ke app Shopify. INTERNAL_API_SECRET harus PERSIS SAMA dengan nilai di
# /etc/treelogy-ab/env, kalau tidak semua aksi ditolak 401.
SHOPIFY_APP_URL=https://ab.treelogy-services.my.id
INTERNAL_API_SECRET=
SHOPIFY_SHOP_DOMAIN=prkdg7-jt.myshopify.com
STOREFRONT_DOMAIN=treelogy.com

# Analytics PostHog sisi browser (opsional). Dibaca saat BUILD — setelah
# mengubahnya, deploy ulang dashboard, `restart` saja tidak cukup.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
