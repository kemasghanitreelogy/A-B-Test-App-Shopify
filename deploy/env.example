# /etc/treelogy-ab/env — root:treelogy-ab, mode 640.
# NODE_ENV, HOST dan PORT diset oleh unit systemd, bukan di sini.

SHOPIFY_APP_URL=https://ab.treelogy-services.my.id
SHOPIFY_API_KEY=f4afe79d74c09bc18bb294e2909ff067
SHOPIFY_API_SECRET=
SCOPES=
SHOP_CUSTOM_DOMAIN=

# Supabase project `treelogy-ab` (ap-southeast-1), role + schema `treelogy_ab`,
# lewat Supavisor session pooler (VPS tidak punya IPv6; host db.<ref> hanya IPv6).
# DIRECT_URL dipakai `prisma migrate`; keduanya session pooler (port 5432).
# postgresql://treelogy_ab.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=treelogy_ab&connection_limit=5
DATABASE_URL=
DIRECT_URL=

# Rahasia bersama dengan dashboard Vercel — nilainya harus PERSIS SAMA di kedua sisi.
INTERNAL_API_SECRET=

AB_COOKIE_DOMAIN=
AB_PROXY_SUBPATH=tl-ab

POSTHOG_PROJECT_TOKEN=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=
POSTHOG_API_HOST=
POSTHOG_PERSONAL_API_KEY=
