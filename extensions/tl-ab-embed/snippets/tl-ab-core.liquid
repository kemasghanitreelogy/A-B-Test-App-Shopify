  function rewriteAnchor(a) {
    if (!a || !a.getAttribute) return;
    var href = a.getAttribute("href");
    if (!href || href.indexOf("/products/") === -1) return;
    if (/^https?:\/\//i.test(href) && href.indexOf(window.location.host) === -1) return;

    var u;
    try { u = new URL(href, window.location.origin); } catch (e) { return; }
    var m = u.pathname.match(/\/products\/([^/?#]+)/);
    if (!m) return;

    var ex = stickyExperimentFor(m[1]);
    if (!ex) return;

    var want = bucketOf(vid, ex.id, ex.s) === "B" ? ex.b : ex.a;
    if (u.searchParams.get("view") === (want || null)) return;
    if (want) u.searchParams.set("view", want);
    else u.searchParams.delete("view");
    a.setAttribute("href", u.pathname + (u.search || "") + (u.hash || ""));
  }

  function rewriteAll() {
    var links = document.querySelectorAll('a[href*="/products/"]');
    for (var i = 0; links.length > i; i++) rewriteAnchor(links[i]);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", rewriteAll);
  } else {
    rewriteAll();
  }

  // Menangkap link yang disisipkan belakangan (quick view, hasil search, infinite
  // scroll). pointerdown selalu mendahului click maupun klik tengah.
  document.addEventListener(
    "pointerdown",
    function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[href*="/products/"]') : null;
      if (a) rewriteAnchor(a);
    },
    true
  );

  /* ---------------------------------------------------------------------
     Menyiarkan variant ke alat analitik lain.

     Alat pihak ketiga tidak tahu arti ?view=ab-b — buat mereka itu query
     parameter biasa. Tanpa siaran ini GA4, GTM, dan heatmap mencampur kunjungan
     variant A dan B jadi satu angka, dan angka campuran itu tetap terlihat masuk
     akal. Tidak ada error yang muncul.

     Sengaja TIDAK lewat utm_*. Menimpa parameter kampanye mengubah atribusi
     order ke iklan berbayar, dan tidak ada satu pun vendor A/B (Optimizely, VWO,
     AB Tasty, Convert, PostHog, GrowthBook, Statsig) yang memakai UTM sebagai
     penanda variant. Google sendiri memindahkan identitas variant KELUAR dari URL
     setelah Optimize dimatikan, menjadi event parameter exp_variant_string.
     --------------------------------------------------------------------- */

  /** Format yang dipakai integrasi resmi GA4: TOOL-EXPERIMENT-VARIANT. */
  function expVariantString(expId, variantName) {
    return "TLAB-" + expId + "-" + variantName;
  }

  function assign(target, source) {
    for (var k in source) {
      if (Object.prototype.hasOwnProperty.call(source, k)) target[k] = source[k];
    }
    return target;
  }

  /**
   * Nama event dataLayer sengaja diberi awalan tl_ab_.
   *
   * Kalau dipakai nama polos seperti "add_to_cart", trigger GTM yang sudah ada di
   * toko ini bisa ikut menyala dan mengirim event GA4 kedua untuk satu tindakan
   * yang sama — revenue dan jumlah event jadi dobel tanpa ada tanda apa pun.
   * Pemetaan ke nama event GA4 yang sebenarnya dilakukan di dalam GTM.
   */
  function broadcast(name, expId, variantName, extra) {
    var payload = assign(
      {
        experiment_id: expId,
        variant: variantName,
        exp_variant_string: expVariantString(expId, variantName),
        visitor_id: vid
      },
      extra || {}
    );

    // GTM / GA4 di storefront. Ini jalur yang didukung penuh — batasan sandbox
    // yang melarang memuat gtag.js hanya berlaku di checkout, bukan di sini.
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(assign({ event: "tl_ab_" + name }, payload));
    } catch (e) {}

    /* Custom customer event: satu-satunya jembatan RESMI ke web pixel. Sandbox
       pixel tidak bisa membaca DOM maupun dataLayer, dan event bawaan
       product_added_to_cart tidak membawa cart attribute sama sekali — jadi tanpa
       siaran ini pixel tidak akan pernah tahu variant pada langkah add-to-cart. */
    try {
      if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === "function") {
        // Dokumentasi mewajibkan awalan nama app diikuti titik dua, supaya
        // tidak bentrok dengan standard event: "my_app:event_name".
        Shopify.analytics.publish("tl_ab:" + name, payload);
      }
    } catch (e) {}

    /* PostHog di browser.

       Yang dilakukan di sini HANYA mendaftarkan properti variant, supaya setiap
       pageview, autocapture, heatmap, dan session replay dari posthog-js bisa
       dipisah per variant.

       Exposure TIDAK dikirim dari sini. Nama event exposure ditentukan PostHog
       per eksperimen ($feature_flag_called untuk eksperimen lama,
       $experiment_exposure untuk yang baru) dan hanya server yang tahu nama itu
       dari jawaban API. Mengirim nama yang salah dari browser tidak ditolak
       PostHog — ia cuma tidak pernah terhitung, dan eksperimen akan terlihat
       kosong tanpa satu pun error. Karena itu exposure selalu dikirim server
       lewat App Proxy, yang sekaligus kebal ad-blocker. */
    try {
      var ph = window.posthog;
      var flagKey = flagKeyOf(expId);
      if (ph && flagKey && typeof ph.register === "function") {
        var reg = {};
        reg["$feature/" + flagKey] = variantName === "B" ? "test" : "control";
        ph.register(reg);
      }
    } catch (e) {}

    /* Titik sambung untuk alat yang belum punya jalur resmi. */
    try {
      if (typeof window.__TL_AB_ON_EVENT__ === "function") window.__TL_AB_ON_EVENT__(name, payload);
    } catch (e) {}
  }

  /** flag key PostHog milik sebuah eksperimen ("k" di config), atau "" kalau tidak ada. */
  function flagKeyOf(expId) {
    for (var i = 0; CFG.ex.length > i; i++) {
      if (CFG.ex[i].id === expId) return CFG.ex[i].k || "";
    }
    return "";
  }

  /* ---------------------------------------------------------------------
     Contentsquare.

     Heatmap dan zoning memilih halaman berdasarkan URL, dan operator "is" yang
     dipakai defaultnya MENGABAIKAN query string. Artinya ?view=ab-b tidak
     memisahkan apa pun di sana: klik variant A dan B menumpuk di satu peta,
     padahal tata letaknya memang sengaja berbeda. Peta campurannya tetap terlihat
     normal.

     Cara yang benar adalah dynamic variable, lalu dijadikan segment, lalu dipakai
     di zoning comparison mode. Ini pola yang sama persis dipakai kedelapan
     integrasi A/B resmi Contentsquare (AB Tasty AB_ABT_, Optimizely AB_OP_,
     Kameleoon AB_kam_, Adobe Target AB_AT_, VWO AB_VWO_, Dynamic Yield AB_DY_,
     Convert AB_CV_, Coveo AB_QB_) — tidak satu pun memakai URL.

     afterPageView dipakai karena dynamic variable yang dikirim sebelum tag
     Contentsquare siap akan hilang tanpa memunculkan error apa pun.
     --------------------------------------------------------------------- */
  function sendToContentsquare(expId, variantName) {
    try {
      window._uxa = window._uxa || [];
      window._uxa.push([
        "afterPageView",
        function () {
          try {
            window._uxa.push([
              "trackDynamicVariable",
              { key: "AB_TL_" + expId, value: variantName }
            ]);
          } catch (e) {}
        }
      ]);
      // Menandai diri sebagai integrasi, mengikuti anjuran snippet resmi mereka.
      if (window.CS_CONF && window.CS_CONF.integrations && window.CS_CONF.integrations.push) {
        window.CS_CONF.integrations.push("Treelogy A/B Test - v1.0.0");
      }
    } catch (e) {}
  }

  /* ---------------------------------------------------------------------
     Identitas GA4.

     Konversi terjadi di checkout, yang berjalan di sandbox pixel dan tidak bisa
     memuat gtag.js. Satu-satunya jalur yang didukung Google untuk membelah
     revenue per variant adalah mengirimnya dari server lewat Measurement
     Protocol — dan itu butuh client_id GA4 milik pengunjung, yang hanya bisa
     dibaca di sini.
     --------------------------------------------------------------------- */

  /** Cookie _ga berbentuk GA1.1.aaa.bbb; client_id adalah dua segmen terakhir. */
  function ga4ClientId() {
    var raw = readCookie("_ga") || "";
    var parts = raw.split(".");
    return parts.length > 3 ? parts.slice(-2).join(".") : "";
  }

  /**
   * session_id ada di cookie _ga_CONTAINER sebagai segmen "s" diikuti unix time.
   * Formatnya tidak didokumentasikan Google, jadi ini best-effort: kalau tidak
   * terbaca, event server tetap terkirim tanpa session_id.
   */
  function ga4SessionId() {
    var m = document.cookie.match(/_ga_[A-Z0-9]+=GS\d+\.\d+\.s(\d+)/);
    return m ? m[1] : "";
  }

  /* ---------------------------------------------------------------------
     Pengumpulan event.

     Semua bersifat fire-and-forget lewat sendBeacon: tidak ada satu pun jalur di
     bawah ini yang boleh memblokir render atau interaksi.
     --------------------------------------------------------------------- */

  function consentOk() {
    try {
      var cp = window.Shopify && window.Shopify.customerPrivacy;
      if (cp && typeof cp.analyticsProcessingAllowed === "function") {
        return cp.analyticsProcessingAllowed();
      }
    } catch (e) {}
    return true; // tidak ada consent API terpasang = tidak ada yang perlu dihormati
  }

  /* Sesi browser: 30 menit idle. Bukan untuk bucketing (itu per visitor), tapi
     untuk metrik per sesi dan pemeriksaan "exposure per sesi" di server. */
  var SESSION_KEY = "_tl_sid";
  var SESSION_IDLE_MS = 30 * 60 * 1000;
  function sessionId() {
    try {
      var raw = sessionStorage.getItem(SESSION_KEY);
      var now = Date.now();
      if (raw) {
        var parts = raw.split("|");
        if (parts[0] && SESSION_IDLE_MS > now - Number(parts[1] || 0)) {
          sessionStorage.setItem(SESSION_KEY, parts[0] + "|" + now);
          return parts[0];
        }
      }
      var fresh = newVisitorId();
      sessionStorage.setItem(SESSION_KEY, fresh + "|" + now);
      return fresh;
    } catch (e) {
      return "";
    }
  }

  /* Kunci atribusi sekunder yang terlihat browser. cart_token diisi dari jawaban
     /cart/update.js — kalau app lain menimpa cart attributes, order masih bisa
     dipasangkan ke visitor ini lewat order.cart_token di webhook. */
  var attributionKeys = {};

  var queue = [];
  function track(expId, variantName, type, productId, unique) {
    queue.push({
      e: expId,
      v: variantName,
      t: type,
      p: productId || "",
      n: unique ? "" : Math.random().toString(36).slice(2, 10)
    });
    scheduleFlush();
  }

  var flushTimer = null;
  function scheduleFlush() {
    if (flushTimer) return;
    flushTimer = setTimeout(flush, 300);
  }

  var keysDirty = false;
  function flush() {
    flushTimer = null;
    if (!consentOk()) { queue.length = 0; keysDirty = false; return; }
    if (!queue.length && !keysDirty) return;
    keysDirty = false;
    var gaClient = ga4ClientId();
    var body = JSON.stringify({
      v: 2,
      vid: vid,
      sid: sessionId(),
      keys: attributionKeys,
      ev: queue.splice(0, 20),
      // Dikirim supaya server bisa mengirim konversi ke GA4 atas nama pengunjung
      // ini. Dihilangkan kalau GA4 tidak terpasang atau cookie-nya belum ada.
      ga: gaClient ? { c: gaClient, s: ga4SessionId() } : undefined
    });
    try {
      if (navigator.sendBeacon) {
        navigator.sendBeacon(CFG.ep, new Blob([body], { type: "text/plain;charset=UTF-8" }));
      } else {
        fetch(CFG.ep, { method: "POST", body: body, keepalive: true });
      }
    } catch (e) {}
  }

  window.addEventListener("pagehide", flush);

  if (experiment && variant) {
    // Jembatan ke web pixel: sandbox pixel tidak bisa membaca DOM, tapi bisa
    // membaca cookie lewat browser.cookie. Ini satu-satunya cara pixel tahu
    // visitor sedang berada di variant mana.
    writeCookie("_tl_ab_last", experiment.id + "|" + variant + "|" + vid, 1, CFG.ckdom);

    // unique=true -> di-dedupe per visitor per hari di server
    track(experiment.id, variant, "exposure", CTX.productId, true);
    track(experiment.id, variant, "product_viewed", CTX.productId, false);

    // Inilah yang membuat GA4, GTM, dan heatmap tahu kunjungan ini variant apa.
    // Nama "experience_impression" mengikuti integrasi eksperimen resmi GA4.
    broadcast("experience_impression", experiment.id, variant, {
      product_id: CTX.productId || "",
      page_type: CTX.pageType || "",
      template_suffix: currentSuffix
    });

    // Sekali per pageview, bukan per event: dynamic variable bersifat kontekstual
    // untuk seluruh pageview, bukan penanda tindakan.
    sendToContentsquare(experiment.id, variant);
  }

  /* ---------------------------------------------------------------------
     Atribusi ke order.

     Variant ditempelkan ke cart sebagai hidden attribute (prefix "_"), sehingga
     ikut terbawa ke Order.note_attributes dan bisa dibaca webhook orders/paid.
     Inilah jalur yang membuat penghitungan konversi kebal ad-blocker.
     --------------------------------------------------------------------- */

  function rememberCartToken(cart) {
    var token = cart && cart.token;
    if (!token || attributionKeys.cart_token === token) return;
    attributionKeys.cart_token = String(token).slice(0, 128);
    keysDirty = true;
    scheduleFlush();
  }

  /* ex = null → hanya _tl_vid yang ditempel. Dilakukan pada SETIAP add-to-cart,
     bukan hanya yang terpapar: order yang membawa visitor id tanpa penugasan
     berarti pengunjungnya memang tidak pernah membuka halaman produk selama
     test (mis. beli dari collection lewat link email) — dan webhook bisa
     membedakannya dari atribusi yang benar-benar hilang. */
  function cartAttributes(ex, variantName) {
    var attrs = {};
    if (ex && variantName) attrs["_tl_ab"] = ex.id + ":" + variantName;
    var abx = membershipString();
    if (abx) attrs["_tl_abx"] = abx;
    attrs["_tl_vid"] = vid;
    return attrs;
  }

  /* Keanggotaan eksperimen komponen = eksperimen yang drawer-nya SUDAH
     dilihat pengunjung ini. Sumbernya atribut _tl_abx yang dibawa keranjang
     (dibaca Liquid di CTX.abc) ditambah exposure di halaman ini, sehingga
     add-to-cart di halaman mana pun tetap membawa keanggotaan yang lengkap. */
  var memberships = {};
  (function () {
    var raw = (CTX.abc && CTX.abc._tl_abx) || "";
    var pairs = String(raw).split(",");
    for (var i = 0; pairs.length > i; i++) {
      var kv = pairs[i].split(":");
      if (kv[0] && (kv[1] === "A" || kv[1] === "B")) memberships[kv[0]] = kv[1];
    }
  })();

  function membershipString() {
    var out = [];
    for (var id in memberships) {
      if (Object.prototype.hasOwnProperty.call(memberships, id)) out.push(id + ":" + memberships[id]);
    }
    return out.join(",");
  }

  function runningComponentExperiment(expId) {
    for (var i = 0; CFG.ex.length > i; i++) {
      if (CFG.ex[i].id === expId && CFG.ex[i].t === "c") return CFG.ex[i];
    }
    return null;
  }

  function stampCart(ex, variantName) {
    var attrs = cartAttributes(ex, variantName);
    try {
      fetch("/cart/update.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ attributes: attrs })
      })
        .then(function (res) { return res && res.ok ? res.json() : null; })
        .then(rememberCartToken)
        .catch(function () {});
    } catch (e) {}
  }

  /* Penangkap add-to-cart dipasang di SEMUA halaman. Yang berbeda hanya
     isinya: di halaman yang ikut test, cart diberi variant dan event funnel
     dikirim; di halaman lain, cart hanya diberi visitor id. */
  function onAddToCart() {
    stampCart(experiment, variant);
    if (experiment && variant) {
      track(experiment.id, variant, "add_to_cart", CTX.productId, false);
      broadcast("add_to_cart", experiment.id, variant, { product_id: CTX.productId || "" });
    }
    trackComponentFunnel("add_to_cart");
  }

  /** Event funnel untuk setiap eksperimen komponen yang sudah diikuti pengunjung ini. */
  function trackComponentFunnel(type) {
    for (var id in memberships) {
      if (!Object.prototype.hasOwnProperty.call(memberships, id)) continue;
      if (!runningComponentExperiment(id)) continue;
      track(id, memberships[id], type, CTX.productId, false);
      broadcast(type, id, memberships[id], { product_id: CTX.productId || "" });
    }
  }

  {
    var origFetch = window.fetch;
    if (typeof origFetch === "function") {
      window.fetch = function (input, init) {
        var url = "";
        try { url = typeof input === "string" ? input : (input && input.url) || ""; } catch (e) {}
        var promise = origFetch.apply(this, arguments);
        if (url.indexOf("/cart/add") !== -1) {
          promise.then(function (res) {
            if (res && res.ok) onAddToCart();
            return res;
          }).catch(function () {});
        }
        return promise;
      };
    }

    // Sebagian theme punya jalur add-to-cart yang mengirim form secara native,
    // tanpa AJAX. Jalur itu tidak pernah menyentuh fetch maupun XHR, jadi tanpa
    // penangkap ini order dari sana tidak ter-atribusi ke variant mana pun.
    //
    // keepalive dipakai supaya request tetap terkirim walau halaman langsung
    // berpindah karena form-nya jalan.
    document.addEventListener(
      "submit",
      function (e) {
        var form = e.target;
        if (!form || !form.getAttribute) return;
        var action = form.getAttribute("action") || "";
        if (action.indexOf("/cart/add") === -1) return;
        try {
          fetch("/cart/update.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            keepalive: true,
            body: JSON.stringify({ attributes: cartAttributes(experiment, variant) })
          }).catch(function () {});
        } catch (err) {}
        if (experiment && variant) {
          track(experiment.id, variant, "add_to_cart", CTX.productId, false);
          broadcast("add_to_cart", experiment.id, variant, { product_id: CTX.productId || "" });
        }
        trackComponentFunnel("add_to_cart");
      },
      true
    );

    // Theme lama masih memakai XMLHttpRequest untuk add-to-cart.
    var origOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url) {
      try {
        if (String(url).indexOf("/cart/add") !== -1) {
          this.addEventListener("load", function () {
            if (this.status >= 200 && 300 > this.status) onAddToCart();
          });
        }
      } catch (e) {}
      return origOpen.apply(this, arguments);
    };
  }

  /* ---------------------------------------------------------------------
     Exposure komponen: saat komponen BENAR-BENAR terlihat.

     Pemicunya harus identik di kedua varian, dan terjadi sebelum isi komponen
     terlihat — kalau tidak, SRM tidak lagi sah. Untuk cart drawer itu kelas
     .active pada .mini-cart: kontrak yang dipakai drawer lama DAN drawer v3
     (juga oleh gtm-events.js untuk view_cart). Pengunjung yang tidak pernah
     membuka drawer tidak ikut eksperimen dan tidak mengencerkannya.
     --------------------------------------------------------------------- */
  var COMPONENT_OPEN_SELECTOR = { cart_drawer: ".mini-cart" };

  function onComponentOpened(key, arm) {
    var ex = arm.ex;
    var v = arm.variant;
    // Varian yang terlihat berbeda dari penugasan (atribut belum tertulis,
    // atau halaman ini akan dimuat ulang): catat, tapi JANGAN hitung exposure.
    if (renderedArm(key) !== v || componentReloading) {
      track(ex.id, v, "render_mismatch", "", true);
      return;
    }
    track(ex.id, v, "exposure", "", true);
    broadcast("experience_impression", ex.id, v, { component: key, page_type: CTX.pageType || "" });
    sendToContentsquare(ex.id, v);
    try {
      var ph = window.posthog;
      if (ph && ex.k && typeof ph.register === "function") {
        var reg = {};
        reg["$feature/" + ex.k] = v === "B" ? "test" : "control";
        ph.register(reg);
        rememberFlagKey(ex.k);
      }
    } catch (e) {}
    if (memberships[ex.id] !== v) {
      memberships[ex.id] = v;
      stampCart(null, null);
    }
  }

  function watchComponents() {
    for (var key in componentArms) {
      if (!Object.prototype.hasOwnProperty.call(componentArms, key)) continue;
      var selector = COMPONENT_OPEN_SELECTOR[key];
      var el = selector ? document.querySelector(selector) : null;
      if (!el) continue;
      (function (key, el) {
        var seen = false;
        var check = function () {
          if (seen || !el.classList.contains("active")) return;
          seen = true;
          onComponentOpened(key, componentArms[key]);
        };
        if (typeof MutationObserver === "function") {
          new MutationObserver(check).observe(el, { attributes: true, attributeFilter: ["class"] });
        }
        check();
      })(key, el);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", watchComponents);
  } else {
    watchComponents();
  }
})();
